# Copia este archivo como .env.local (nunca se sube al repo).
# Con SAMPLE_MODE=true (por defecto) el agente corre SIN ninguna de estas claves.
SAMPLE_MODE=true

# Modo real: el motor io-engine levantado aparte (docker compose up en io-engine).
# Desde Docker, usa http://host.docker.internal:8000/mcp
IO_MOTOR_URL=http://localhost:8000/mcp

# Modo real: Meterless Nightshift, el proveedor principal de IA (la clave de NVIDIA va en
# Nightshift → Providers, NO aquí).
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Si el principal falla tras sus reintentos, se intenta una vez con este (también Nemotron):
METERLESS_MODELO_RESPALDO=nvidia/nemotron-3.5-lightning-30b-a3b
# Los modelos que razonan necesitan margen para escribir la respuesta (con menos, vuelve vacía):
METERLESS_EXTRA_BODY={"max_tokens": 4000}
# Si el modelo tarda demasiado "pensando" (Nightshift corta a los ~45 s con provider_deadline):
METERLESS_STREAM=true
# Reintentos por llamada si Nightshift corta la respuesta (provider_deadline):
AGENTE_REINTENTOS_MODELO=3
# AGENTE_SIN_PENSAR=true
# METERLESS_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# Topes
AGENTE_TIMEOUT_S=300
AGENTE_MAX_ITERACIONES=16
AGENTE_PRESUPUESTO_USD=1.0
# Veces que el Evaluador puede devolver una misma afirmación antes de que el agente se abstenga
AGENTE_TOPE_DEVOLUCIONES=2
